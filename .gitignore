.DS_Store
.venv/
tmp/
__pycache__/
*.pyc

# R package build and check artifacts
*.Rcheck/
*.tar.gz

# LaTeX build artifacts (the final PDF under output/pdf is versioned)
main.aux
main.bbl
main.blg
main.fdb_latexmk
main.fls
main.log
main.out
main.pdf
*.synctex.gz

# Downloaded datasets and generated benchmark intermediates
data/raw/**
results/
# ...but every raw-data provenance README is versioned. A bare `data/raw/`
# rule would exclude the directory itself, and Git cannot re-include a file
# whose parent directory is excluded, so match the contents instead.
!data/raw/**/
!data/raw/**/README.md
# ...but the manuscript source directory of the same name is versioned
!sections/results/

# Generated figures. The three the manuscript cites are versioned in the
# overleaf/ submodule; publish them with scripts/publish_figures.sh.
figures/*.pdf
figures/*.png

# Rendered page images used only for visual QA
output/rendered/
.Rproj.user

# R package compiled artifacts and session history
src/*.o
src/*.so
.Rhistory
