.DS_Store
.venv/
tmp/
__pycache__/
*.pyc

# R package build and check artifacts
*.Rcheck/
*.tar.gz

# LaTeX build artifacts (the final PDF under output/pdf is versioned)
main.aux
main.bbl
main.blg
main.fdb_latexmk
main.fls
main.log
main.out
main.pdf
*.synctex.gz

# Downloaded datasets and generated benchmark intermediates
data/raw/
results/

# Rendered page images used only for visual QA
output/rendered/

# pixi environments. pixi.toml and pixi.lock are versioned; the several-GB
# solved environment under .pixi/ is rebuilt from them by `pixi install`.
.pixi/

# Toolchains pixi cannot supply as conda packages, installed by
# `pixi run setup-julia` and pinned by checksum in scripts/setup_julia.sh.
.tools/

# marimo / Python caches
__marimo__/
.pytest_cache/
